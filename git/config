[user]
	email = peter@devthe.net
	name = Peter Garbers
	# key file on disk, not the 1Password agent (no Touch ID per commit)
	signingkey = ~/.ssh/id_ed25519_signing
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[include]
	# machine-local overrides (gitignored; work email/signing, see install.sh)
	path = config.local
