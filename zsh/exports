# =============================================================================
# ZSH EXPORTS - Environment Variables (macOS)
# =============================================================================

# Language environment
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# Editor preferences
export EDITOR='subl -w'
export VISUAL='subl -w'

# Go: the toolchain comes from mise (global default in ~/.config/mise/config.toml),
# which also sets GOROOT and GOBIN per version. GOPATH holds the module cache.
export GOPATH=$HOME/go
export PATH=$PATH:$GOPATH/bin

# Docker configuration
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# FZF configuration
export FZF_DEFAULT_OPTS='--height 40% --layout=reverse --border'
if command -v fd &> /dev/null; then
    export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git --exclude node_modules --exclude .DS_Store'
fi

# Add ~/.local/bin to PATH
export PATH="$HOME/.local/bin:$PATH"
